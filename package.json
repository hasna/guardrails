{
  "name": "@hasna/guardrails",
  "version": "0.1.0",
  "description": "Local-first guardrail and policy decisions for agentic systems.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hasna/guardrails.git"
  },
  "homepage": "https://github.com/hasna/guardrails#readme",
  "bugs": {
    "url": "https://github.com/hasna/guardrails/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "guardrails": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "hasna.contract.json"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/cli/index.ts --outdir dist --target bun && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "contract-check": "bunx @hasna/contracts@0.8.5 repo-conformance .",
    "scan:artifact": "bun scripts/scan-artifact.ts",
    "prepack": "bun run scan:artifact",
    "prepublishOnly": "bun run typecheck && bun run test && bun run contract-check && bun run build && bun run scan:artifact"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^5.7.3"
  }
}
